# Copy to .env for local development of the API (npm run dev:api). Never commit real keys.
APP_ENV=development
PORT=8787
MODEL_MODE=local-first
ENABLE_LOCAL_AI=true
# Connected AI (opt-in Gemma behind MERA's server). Leave false to run without it.
ENABLE_REMOTE_AI=false
# OpenAI-compatible endpoint serving a Gemma model, e.g. Google AI Studio or a local Ollama:
#   https://generativelanguage.googleapis.com/v1beta/openai   (MODEL_NAME=gemma-3-27b-it)
#   http://localhost:11434/v1                                  (MODEL_NAME=gemma3:4b)
MODEL_ENDPOINT=
MODEL_NAME=
MODEL_API_KEY=
REMOTE_AI_RATE_LIMIT=40
